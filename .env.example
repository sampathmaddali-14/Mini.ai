# Mini.ai — environment variables
# Copy this file to `.env` at the repo root and fill in the values.
# `.env` is gitignored. Never commit secrets.

# --- Required ---

# Anthropic API key. Used by memos, openspace, and openclaw for reasoning.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional ---

# OpenAI key — only set if you want MemOS to use OpenAI for some internal LLM ops
# (embeddings, summarization). Leave blank to use the Anthropic model end-to-end.
OPENAI_API_KEY=

# Default model MemOS uses for its internal LLM operations.
MEMOS_DEFAULT_MODEL=claude-opus-4-7

# Whether OpenClaw fires heartbeat (cron) jobs. Set to `false` to run on-demand only.
HEARTBEAT_ENABLED=true

# Log verbosity for OpenClaw. One of: debug, info, warn, error.
LOG_LEVEL=info
